{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "playwright-mcp",
        "--headless",
        "--isolated",
        "--output-dir",
        ".ai/mcp-output/playwright",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "60000"
      ]
    }
  }
}
