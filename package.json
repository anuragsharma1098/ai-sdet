{
  "name": "ai-sdet-playwright-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "AI-SDET automation framework using Playwright and TypeScript.",
  "scripts": {
    "prepare": "husky",
    "clean:allure": "node -e \"const fs=require('fs'); for (const path of ['allure-results','allure-report']) fs.rmSync(path,{recursive:true,force:true});\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "pretest": "npm run clean:allure",
    "test": "playwright test --grep-invert \"@desktop|@mobile\"",
    "test:web": "playwright test tests/web",
    "test:api": "playwright test tests/api",
    "test:desktop": "playwright test tests/desktop",
    "test:mobile": "playwright test tests/mobile",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "mcp:playwright": "playwright-mcp --headless --isolated --output-dir .codex/playwright-mcp-output --timeout-action 10000 --timeout-navigation 60000"
  },
  "lint-staged": {
    "*.{ts,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@openai/codex": "^0.142.5",
    "@playwright/mcp": "^0.0.77",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "webdriverio": "^9.0.0",
    "zod": "^3.23.8"
  }
}
